# Entorno: development | test | production
NODE_ENV=development
PUERTO=4000

# Ruta del archivo SQLite (relativa a la carpeta backend). Usa :memory: para pruebas.
DB_RUTA=data/velora.db

# Secreto para firmar los JWT. OBLIGATORIO en producción (mínimo 32 caracteres).
JWT_SECRETO=cambia-este-secreto-por-uno-largo-y-aleatorio-123456
JWT_EXPIRACION=8h

# Orígenes permitidos para CORS, separados por coma (el frontend de Vite corre en 5173).
CORS_ORIGENES=http://localhost:5173

# Reglas de negocio de la reserva
TARIFA_LIMPIEZA=180000
IMPUESTOS_PORCENTAJE=0.19

# Imágenes subidas desde el panel de administración
UPLOADS_RUTA=uploads
IMAGEN_MAX_MB=5
# URL pública del backend (opcional). Úsala si el servidor está detrás de un dominio o proxy.
# URL_PUBLICA=https://api.mi-hotel.com

# Dirección del sitio (frontend): se usa en los enlaces de los correos (restablecer contraseña, mis reservas).
URL_SITIO=http://localhost:5173

# Política de cancelación: días antes de la llegada en que todavía es gratis (2 = 48 horas).
CANCELACION_GRATIS_DIAS=2

# Bloqueo de cuentas: intentos fallidos permitidos y minutos de bloqueo.
BLOQUEO_INTENTOS=5
BLOQUEO_MINUTOS=15

# Días que se conservan los registros de acceso (IP y navegador son datos personales).
ACCESOS_RETENCION_DIAS=90

# Pesos colombianos por dólar, solo para mostrar precios aproximados en USD (siempre se cobra en COP).
TASA_USD=4000

# Correo saliente. Sin SMTP_HOST los correos se guardan como .html en CORREOS_RUTA (para desarrollo).
# SMTP_HOST=smtp.tu-proveedor.com
# SMTP_PUERTO=587
# SMTP_USUARIO=usuario
# SMTP_CLAVE=clave
CORREO_REMITENTE=Velora <no-responder@velora.com>
CORREOS_RUTA=data/correos
